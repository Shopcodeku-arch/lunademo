# Tidak ada API key yang dibutuhkan.
# Luna memanggil AI lewat server sendiri (/api/ai/chat) yang meneruskan ke Overchat API.
# Variabel opsional:
# PORT=3000

# (Opsional) Cadangan pengunduh TikTok lewat RapidAPI. Utamanya Luna memakai tikwm.com tanpa key.
# Isi di Vercel -> Settings -> Environment Variables. JANGAN ditulis di kode.
# RAPIDAPI_KEY=
